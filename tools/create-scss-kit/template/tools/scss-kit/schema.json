{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "scss-kit config",
  "type": "object",
  "required": ["design", "paths", "themeKit", "coefficients"],
  "properties": {
    "design": {
      "type": "object",
      "required": ["desktopWidth", "mobileWidth"],
      "properties": {
        "desktopWidth": {"type": "integer", "minimum": 320},
        "mobileWidth": {"type": "integer", "minimum": 320},
        "note": {"type": "string"}
      }
    },
    "fixedCore": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["breakpoint", "width"],
          "properties": {
            "breakpoint": {"type": "number", "exclusiveMinimum": 0},
            "width": {"type": "number", "exclusiveMinimum": 0}
          },
          "additionalProperties": false
        }
      ]
    },
    "responsive": {
      "type": "object",
      "properties": {
        "mobileClampMode": {
          "type": "string",
          "enum": ["auto", "min-first", "max-first", "dual-bound"]
        },
        "smallMobileThreshold": {"type": "integer", "minimum": 1},
        "dualClampMinWidth": {"type": "integer", "minimum": 1},
        "dualClampMaxWidth": {"type": "integer", "minimum": 1}
      }
    },
    "paths": {
      "type": "object",
      "required": ["scssSrcDir", "cssOutDir"],
      "properties": {
        "scssSrcDir": {"type": "string"},
        "cssOutDir": {"type": "string"}
      }
    },
    "autofill": {
      "type": "object",
      "properties": {
        "function": {"type": "string"},
        "vwFunction": {"type": "string"},
        "mobileMax": {"type": "integer", "minimum": 1},
        "scanDirs": {"type": "array", "items": {"type": "string"}},
        "output": {"type": "string"},
        "entries": {
          "type": "array",
          "items": {
            "oneOf": [
              {"type": "string"},
              {
                "type": "object",
                "required": ["file"],
                "properties": {
                  "file": {"type": "string"},
                  "varScope": {"type": "string"}
                },
                "additionalProperties": false
              }
            ]
          }
        }
      }
    },
    "themeKit": {
      "type": "object",
      "required": ["env", "configYml", "ignoreFiles"],
      "properties": {
        "env": {"type": "string"},
        "configYml": {"type": "string"},
        "ignoreFiles": {"type": "array", "items": {"type": "string"}}
      }
    },
    "coefficients": {
      "type": "object",
      "required": ["readable", "dense"],
      "properties": {
        "readable": {"$ref": "#/$defs/profile"},
        "dense": {"$ref": "#/$defs/profile"}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "profile": {
      "type": "object",
      "required": ["min", "max"],
      "properties": {
        "min": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "max": {"type": "number", "minimum": 1}
      },
      "additionalProperties": false
    }
  }
}
