{
  "$schema": "./tools/scss-kit/schema.json",
  "design": {
    "desktopWidth": 1920,
    "mobileWidth": 750,
    "note": "设计稿尺寸：PC(1920) + Mobile(750)。边界由 readable/dense 系数直接计算。"
  },
  "responsive": {
    "mobileClampMode": "auto",
    "smallMobileThreshold": 400,
    "dualClampMinWidth": 500,
    "dualClampMaxWidth": 600
  },
  "paths": {
    "scssSrcDir": "src/styles",
    "cssOutDir": "assets"
  },
  "autofill": {
    "function": "r.resp",
    "vwFunction": "r.vw",
    "mobileMax": 850,
    "scanDirs": [
      "src/styles"
    ],
    "output": "src/styles/_responsive-autofill.generated.scss",
    "entries": []
  },
  "themeKit": {
    "env": "development",
    "configYml": "config.yml",
    "ignoreFiles": [
      "src/**",
      "node_modules/**",
      "package.json",
      "package-lock.json",
      "pnpm-lock.yaml",
      "yarn.lock",
      "vite.config.*",
      "tsconfig.*",
      "README.md"
    ]
  },
  "coefficients": {
    "readable": {
      "min": 0.625,
      "max": 1.5
    },
    "dense": {
      "min": 0.5,
      "max": 1.5
    }
  },
  "fixedCore": null
}
